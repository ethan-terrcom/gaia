            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seq"
          },
          "ts": {
            "format": "date-time",
            "title": "Ts",
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/EventType"
          },
          "workspace_id": {
            "title": "Workspace Id",
            "type": "string"
          }
        },
        "required": [
          "seq",
          "id",
          "workspace_id",
          "run_id",
          "agent_id",
          "type",
          "payload",
          "ts"
        ],
        "title": "EventRecord",
        "type": "object"
      },
      "EventType": {
        "description": "Every event the bus can carry (doc 13).\n\n``stream.gap`` is transport-only: the bus inserts it into a subscriber's\nqueue when that subscriber overflowed, but it is never written to the\n``event`` table.",
        "enum": [
          "run.created",
          "run.status_changed",
          "run.node_started",
          "run.node_finished",
          "run.budget_exceeded",
          "run.failed",
