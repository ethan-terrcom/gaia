      "EventRecord": {
        "description": "The wire format of one event, and what the bus hands subscribers.\n\nPersisted events always have an integer ``seq`` and an ``id``. A\n``stream.gap`` marker is transport-only: it has ``seq=None`` and ``id=None``\nand is never written to the database.",
        "properties": {
          "agent_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Agent Id"
          },
