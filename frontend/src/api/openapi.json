  "info": {
    "summary": "Local-first control plane for a hierarchy of AI coding agents.",
    "title": "Gaia",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "description": "Answer without touching the database or the keychain.\n\nA probe that failed because the database was busy, or the keychain was\nlocked, would report the wrong problem. \"The process answers HTTP\" is what\nthis says, and it is the only thing a supervisor needs.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/agents": {
      "get": {
        "description": "Return the workspace's agents, newest first by UUIDv7 id.",
        "operationId": "list_agents_api_v1_agents_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
